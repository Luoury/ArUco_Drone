<?xml version="1.0" encoding="UTF-8"?>
<!-- ArUco 码（id=2），供多工位演示用。
     几何与材质照抄 PX4 自带的 arucotag：0.5 m x 0.5 m 静态平面，
     贴图由 cv2.aruco.generateImageMarker(DICT_4X4_50, 2, 354, borderBits=1) 生成
     （6x6 格 = 4x4 数据 + 1 圈黑边，无额外白静区），与检测端 marker_size 0.487 对应。 -->
<sdf version="1.6">
  <model name="arucotag_2">
    <static>true</static>
    <pose>0 0 0.001 0 0 0</pose>
    <link name="base">
      <visual name="base_visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.5 0.5</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://arucotag_2/arucotag.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
