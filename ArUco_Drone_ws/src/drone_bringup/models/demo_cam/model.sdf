<?xml version="1.0" encoding="UTF-8"?>
<!-- 演示机位：斜俯视（不是正下方），把 2.5 m x 2.5 m 的四个工位全装进画面，并留出机动余量。
     位置 (-2.2, -2.2, 3.8)，俯角 0.6578 rad（约 37.7°），偏航 0.7854 rad（45°，朝 +x+y），
     光轴指向 (1.15, 1.15, 0) —— 四个工位中心稍偏基站一侧，保证基站(0,0)也有留白。
     视场 1.3 rad：距机位 6 m 处横向覆盖约 9.3 m，无人机在工位之间机动不会出画。
     分辨率 960x540@10：软件渲染下两台相机抢同一个渲染器，配大了会把机载相机拖垮
     （实测 1280x720@30 时主相机掉到 ~5 Hz，视觉降落失败）。 -->
<sdf version="1.6">
  <model name="demo_cam">
    <static>true</static>
    <pose>-2.2 -2.2 3.8 0 0.6578 0.7854</pose>
    <link name="link">
      <sensor name="camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.3</horizontal_fov>
          <image>
            <width>960</width>
            <height>540</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <gz_frame_id>demo_cam</gz_frame_id>
      </sensor>
    </link>
  </model>
</sdf>
